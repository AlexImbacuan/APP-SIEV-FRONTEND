# Copie este archivo como .env.development.local (local) o configure estas
# variables en Netlify (producción). Si no se definen, se usan los valores de abajo.

# URL base del backend APP-SIEV (sin "/" al final)
#   Local:      http://localhost:8080
#   Producción: https://app-siev-backend.onrender.com
REACT_APP_API_URL=https://app-siev-backend.onrender.com

# Rutas de autenticación (el backend las acepta con y sin el prefijo /api)
# REACT_APP_AUTH_LOGIN=/auth/login
# REACT_APP_AUTH_REFRESH=/auth/refresh
# REACT_APP_AUTH_LOGOUT=/auth/logout
# REACT_APP_AUTH_ME=/api/auth/me
